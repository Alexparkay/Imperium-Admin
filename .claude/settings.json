{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:fix)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run generate:presets)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b imperium/*)",
      "Read(./**)",
      "Edit(src/**)",
      "Edit(.imperium/**)",
      "Edit(docs/**)",
      "Edit(public/**)",
      "Write(src/**)",
      "Write(.imperium/**)",
      "Write(docs/**)",
      "Write(public/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(npm install:*)"
    ]
  }
}
